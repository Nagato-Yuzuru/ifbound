{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  // The commit-msg hook and the pr-title check require Conventional Commits.
  semanticCommits: "enabled",
  // A new release must be 7 days old before an update branch exists.
  minimumReleaseAge: "7 days",
  internalChecksFilter: "strict",
  postUpdateOptions: ["gomodTidy"],
  timezone: "Asia/Taipei",
  // GitHub advisories miss many Go vulnerabilities. osv.dev includes the
  // Go vulnerability database that govulncheck uses.
  osvVulnerabilityAlerts: true,
  // A security update skips the 7-day wait and goes to the lowest fixed
  // version. Without the wait, a compromised release is not filtered out,
  // so a person reviews each one. It does not join the weekly group and
  // does not wait for the schedule.
  vulnerabilityAlerts: {
    automerge: false,
    labels: ["security"],
  },
  packageRules: [
    {
      // One PR each week holds all non-major updates, so that the CI runs
      // once for them.
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
      groupName: "non-major dependencies",
      schedule: ["before 6am on monday"],
      automerge: true,
    },
    {
      // The default disables indirect Go modules. A vulnerability in an
      // indirect module (for example golang.org/x/net) then gets no update.
      matchManagers: ["gomod"],
      matchDepTypes: ["indirect"],
      enabled: true,
    },
    {
      // The DNS plugin depends on the behavior of these modules. A person
      // reviews each update. They have their own group, so that the weekly
      // group can merge without a review.
      matchPackageNames: [
        "github.com/coredns/coredns",
        "github.com/coredns/caddy",
        "github.com/miekg/dns",
      ],
      groupName: "CoreDNS",
      automerge: false,
    },
    {
      // The CoreDNS plugin API uses caddy types, so the caddy major version
      // must be the one that CoreDNS uses (v1 in CoreDNS v1.15.0). Another
      // major version does not compile.
      matchPackageNames: ["github.com/coredns/caddy"],
      allowedVersions: "<2",
    },
    {
      // A Go point release usually fixes a vulnerability in the standard
      // library. Neither osv.dev nor GitHub advisories match it to the
      // toolchain version, so it does not get a security update. It skips the
      // weekly group and the 7-day wait, and a person reviews it.
      matchManagers: ["mise"],
      matchDepNames: ["go"],
      groupName: null,
      schedule: ["at any time"],
      minimumReleaseAge: null,
      automerge: false,
    },
  ],
}
