{#- Renders internal/logattr/attrs.go from the v2 context of the registry in telemetry/. -#}
{#- The semconv attributes are every attribute that a group, event, span, metric, or entity of the registry references, and that the registry does not define. -#}
{%- set own = ctx.registry.attributes | map(attribute="key") | list -%}
{%- set ns = namespace(all=[]) -%}
{%- for g in ctx.registry.attribute_groups %}{% set ns.all = ns.all + (g.attributes | default([])) %}{% endfor -%}
{%- for g in ctx.registry.events %}{% set ns.all = ns.all + (g.attributes | default([])) %}{% endfor -%}
{%- for g in ctx.registry.spans %}{% set ns.all = ns.all + (g.attributes | default([])) %}{% endfor -%}
{%- for g in ctx.registry.metrics %}{% set ns.all = ns.all + (g.attributes | default([])) %}{% endfor -%}
{%- for g in ctx.registry.entities %}{% set ns.all = ns.all + (g.identity | default([])) + (g.description | default([])) %}{% endfor -%}
{%- set semconv = ns.all | rejectattr("key", "in", own) | sort(attribute="key") | unique(attribute="key") | list -%}
{%- macro value_consts(attr, members) -%}

// Values of {{ attr.annotations.go.name }}.
const (
{%- for m in members %}
{%- if not loop.first %}
{% endif %}
	// {{ m.brief | trim | replace("\n", " ") }}
	{{ m.annotations.go.name }} = "{{ m.value }}"
{%- endfor %}
)
{%- endmacro -%}
// Code generated by weaver from telemetry/. DO NOT EDIT.

// Package logattr holds the names of the log attributes. The registry in
// telemetry/ defines them. A name is a contract with the queries of the
// operator once a call site writes it: do not rename it then.
// docs/telemetry.md describes each name.
package logattr

// Log attribute names.
const (
{%- for attr in ctx.registry.attributes %}
{%- if not loop.first %}
{% endif %}
	// {{ attr.brief | trim | replace("\n", " ") }}
	{{ attr.annotations.go.name }} = "{{ attr.key }}"
{%- endfor %}
{%- for attr in semconv %}

	// {{ attr.brief | trim | replace("\n", " ") }}
	{{ attr.key | pascal_case }} = "{{ attr.key }}"
{%- endfor %}
)
{%- for attr in ctx.registry.attributes if attr.type.members is defined %}

{{ value_consts(attr, attr.type.members) }}
{%- endfor %}
